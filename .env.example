# Copy to .env and fill in. Never commit .env.

# ---- Crypto exchanges (Kraken / Binance / etc. via ccxt) ----
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSWORD=

# ---- Trading 212 Invest ----
# Request API access from the T212 app: Settings -> API -> Generate new key.
# Approval can take a few days. Live key for live.trading212.com; demo key
# for demo.trading212.com (set exchange.sandbox: true in config.yaml).
TRADING212_API_KEY=

# Optional: Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
